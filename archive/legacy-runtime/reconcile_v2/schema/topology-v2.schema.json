{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/schemas/topology-v2.schema.json",
  "title": "Topology V2",
  "type": "object",
  "additionalProperties": true,
  "required": ["version", "metadata", "nodes", "edges", "geometry_index", "quality"],
  "properties": {
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "metadata": {
      "type": "object",
      "required": ["generated_at", "pipeline_version", "source_hashes"],
      "properties": {
        "uuid": {"type": "string"},
        "generated_at": {"type": "string"},
        "pipeline_version": {"type": "string"},
        "source_hashes": {
          "type": "object",
          "required": ["merged_sha256", "scan_manifest_sha256"],
          "properties": {
            "merged_sha256": {"type": "string"},
            "scan_manifest_sha256": {"type": "string"}
          }
        }
      }
    },
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "type"],
        "properties": {
          "id": {"type": "string"},
          "type": {"type": "string"},
          "story": {"type": ["integer", "null"]},
          "confidence": {"type": ["number", "null"]},
          "source": {"type": ["string", "null"]},
          "source_ids": {"type": "array", "items": {"type": "string"}},
          "transform_ref": {"type": ["string", "null"]},
          "bbox_xz": {
            "type": ["array", "null"],
            "items": {"type": "number"},
            "minItems": 4,
            "maxItems": 4
          },
          "metrics": {"type": "object"},
          "legacy_refs": {"type": "object"},
          "ifc_class": {"type": ["string", "null"]},
          "properties": {"type": "object"}
        }
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "type", "from", "to"],
        "properties": {
          "id": {"type": "string"},
          "type": {"type": "string"},
          "from": {"type": "string"},
          "to": {"type": "string"},
          "confidence": {"type": ["number", "null"]},
          "source": {"type": ["string", "null"]},
          "evidence": {"type": "object"},
          "ifc_relation": {"type": ["string", "null"]}
        }
      }
    },
    "geometry_index": {
      "type": "object",
      "required": ["transforms", "surface_polygons", "room_floor_polygons"],
      "properties": {
        "transforms": {"type": "object"},
        "surface_polygons": {"type": "object"},
        "room_floor_polygons": {"type": "object"}
      }
    },
    "quality": {
      "type": "object"
    }
  }
}
